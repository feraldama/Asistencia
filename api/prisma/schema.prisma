generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model UsuarioAdmin {
  id       Int    @id @default(autoincrement())
  username String @unique
  password String
}

model Empleado {
  id              Int          @id @default(autoincrement())
  documento       String       @unique
  nombre_completo String
  asistencias     Asistencia[]
}

model Asistencia {
  id         Int      @id @default(autoincrement())
  employee_id Int
  empleado   Empleado @relation(fields: [employee_id], references: [id])
  tipo       TipoAsistencia
  timestamp  DateTime @default(now())
}

enum TipoAsistencia {
  ENTRADA
  SALIDA
}
